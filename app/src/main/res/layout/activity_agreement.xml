<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/agreementContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/agreement_welcome"
                android:textColor="@color/text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/agreement_summary"
                android:textColor="@color/text_hint"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/agreementPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_tonal"
                android:stateListAnimator="@null"
                android:paddingVertical="12dp"
                android:text="@string/agreement_privacy_button"
                android:textColor="@color/text_dark" />

            <Button
                android:id="@+id/agreementTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_tonal"
                android:stateListAnimator="@null"
                android:paddingVertical="12dp"
                android:text="@string/agreement_terms_button"
                android:textColor="@color/text_dark" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/agreementCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/agreement_check_label"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/agreementAccept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button"
        android:enabled="false"
        android:stateListAnimator="@null"
        android:paddingVertical="14dp"
        android:text="@string/agreement_accept"
        android:textColor="@color/on_primary" />

    <Button
        android:id="@+id/agreementDecline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_tonal"
        android:stateListAnimator="@null"
        android:paddingVertical="12dp"
        android:text="@string/agreement_decline"
        android:textColor="@color/text_dark" />
</LinearLayout>
